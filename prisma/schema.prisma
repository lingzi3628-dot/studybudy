// =====================================================================
// Phase 20 — Family Mode
// =====================================================================
// A "Family" is created by a parent who registers one email + password
// and then creates 2+ child profiles. Each child has their own username
// + passcode (created by the parent) and their own User row so progress,
// tokens, and coins are tracked independently.
//
// Children log in via /api/family/login using { username, passcode }
// — they never see or use the parent's email.
// =====================================================================

model Family {
  id            String   @id @default(uuid())
  parentUserId  String   @unique  // links to users.id (parent's account)
  parentEmail   String            // denormalized for display
  displayName   String?           // "The Smith Family" (optional)
  createdAt     DateTime @default(now())

  children      FamilyChild[]
}

model FamilyChild {
  id            String   @id @default(uuid())
  familyId      String
  userId        String   @unique  // the child's own User row
  parentUserId  String             // denormalized for quick lookup
  username      String   @unique   // GLOBALLY unique — child logs in with this
  displayName   String             // "Alex", "Sam"
  passcodeHash  String             // bcrypt hash of passcode
  gradeLevel    String?            // optional: "Grade 3", "Form 1"
  avatarEmoji   String?            // optional: "🦊", "🐼"
  createdAt     DateTime @default(now())
  lastLogin     DateTime?

  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([parentUserId])
}

// =====================================================================
// Phase 22 — Curriculum Engine
// =====================================================================
// Admin-curated study database. The admin uploads a PDF or pastes content
// per grade + subject, and the AI engine parses it into:
//   - Topics (chapters/lessons with markdown content)
//   - Flashcards (front/back Q&A pairs)
//   - Quiz questions (MCQs with explanations)
//   - A learning path (ordered sequence of topics)
//
// When a user logs in (personal or family mode), their dashboard shows the
// subjects for their grade. The AI Tutor, flashcard generator, and quiz
// generator pull from this curated content FIRST — no more hallucination.
//
// Grades have a status: 'ready' (selectable in onboarding) or 'coming_soon'
// (shown greyed-out with a "we'll email you when ready" message).
// =====================================================================

model CurriculumGrade {
  id          String   @id @default(uuid())
  name        String   @unique   // "Grade 1", "Grade 2", "Form 1", etc.
  level       String             // "primary" | "secondary"
  orderIndex  Int      @default(0)
  status      String   @default("coming_soon")  // 'ready' | 'coming_soon'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    CurriculumSubject[]
  exams       CurriculumExam[]
  sourceDocs  CurriculumSourceDoc[]
}

model CurriculumSubject {
  id          String   @id @default(uuid())
  gradeId     String
  name        String             // "Mathematics", "English", etc.
  icon        String   @default("📚")  // emoji or short text
  imageUrl    String?                  // optional photo for the dashboard card
  color       String   @default("#6366F1")
  description String?                  // shown on the dashboard card
  status      String   @default("locked")  // 'locked' | 'unlocked' — Phase 22c
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade       CurriculumGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  topics      CurriculumTopic[]
  sourceDocs  CurriculumSourceDoc[]
  exams       CurriculumExam[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model CurriculumTopic {
  id              String   @id @default(uuid())
  subjectId       String
  name            String                   // "Lines and Shapes", "Addition", etc.
  slug            String                   // url-friendly
  summary         String?                  // 1-2 sentence AI-generated summary
  contentMarkdown String?                   // full lesson content (markdown)
  orderIndex      Int      @default(0)     // learning path order
  estimatedMin    Int      @default(10)     // estimated study time
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject         CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  flashcards      CurriculumFlashcard[]
  quizQuestions   CurriculumQuizQuestion[]

  @@index([subjectId])
}

model CurriculumFlashcard {
  id          String   @id @default(uuid())
  topicId     String
  front       String                    // question / prompt
  back        String                    // answer / explanation
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic       CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model CurriculumQuizQuestion {
  id            String   @id @default(uuid())
  topicId       String
  questionText  String
  options       Json                     // string[] — e.g. ["A", "B", "C", "D"]
  correctIndex  Int                      // 0-based index into options
  explanation   String?
  difficulty    String   @default("easy") // 'easy' | 'medium' | 'hard'
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topic         CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model CurriculumSourceDoc {
  id            String   @id @default(uuid())
  gradeId       String
  subjectId     String?
  fileName      String                   // original filename
  rawText       String                   // extracted plain text
  sourceType    String   @default("pdf") // 'pdf' | 'doc' | 'paste'
  uploadedBy    String?                  // admin userId
  parsingStatus String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  parseError    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grade         CurriculumGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject       CurriculumSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([gradeId])
  @@index([subjectId])
}

model CurriculumExam {
  id              String   @id @default(uuid())
  gradeId         String
  subjectId       String
  schoolId        String?                  // optional — links to School model for school-specific exams
  title           String                   // "Grade 1 Mathematics End Term 1 Exam"
  description     String?
  durationMinutes Int      @default(30)
  passThreshold   Float    @default(0.5)   // 0..1
  status          String   @default("draft") // 'draft' | 'published'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grade           CurriculumGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject         CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       CurriculumExamQuestion[]

  @@index([gradeId])
  @@index([subjectId])
  @@index([schoolId])
}

model CurriculumExamQuestion {
  id            String   @id @default(uuid())
  examId        String
  questionText  String
  options       Json                     // string[]
  correctIndex  Int
  explanation   String?
  marks         Int      @default(1)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  exam          CurriculumExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}


// =====================================================================
// Phase 22c — Notification log
// =====================================================================
// When an admin unlocks a new subject for a grade, we record a notification
// for each user who has that grade. The notification is stored here so the
// admin can see who would be notified (via WhatsApp / SMS / email).
//
// Later, when we wire up a real WhatsApp/SMS gateway, we'll send these
// notifications and update `status` to 'sent'.
// =====================================================================

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String
  channel     String   // 'whatsapp' | 'sms' | 'email'
  recipient   String   // phone number or email
  subject     String
  body        String
  status      String   @default("pending")  // 'pending' | 'sent' | 'failed'
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =====================================================================
// Phase 22d — Capacity Engine
// =====================================================================
// Tracks each student's "capacity" — a measure of their ability + readiness
// to advance to the next topic or subject. Built from:
//   - Quiz scores per topic
//   - Completion rates
//   - Study time
//   - Streak consistency
//
// The engine computes a capacity score (0-100) per topic + per subject +
// overall, and recommends whether the student should:
//   - Review the current topic
//   - Move to the next topic
//   - Move to the next subject
// =====================================================================

model StudentCapacity {
  id              String   @id @default(uuid())
  userId          String
  subjectId       String?  // null = overall capacity across all subjects
  topicId         String?  // null = subject-level or overall
  capacityScore   Float    @default(0)  // 0..100
  masteryLevel    Float    @default(0)  // 0..1 (from quiz scores)
  completionRate  Float    @default(0)  // 0..1 (topics completed / total)
  studyTimeMin    Int      @default(0)
  attemptsCount   Int      @default(0)
  correctCount    Int      @default(0)
  recommendation  String   @default("start")  // 'start' | 'review' | 'practice' | 'advance' | 'mastered'
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([userId, subjectId, topicId])
  @@index([userId])
  @@index([subjectId])
}

model TopicProgression {
  id              String   @id @default(uuid())
  userId          String
  topicId         String   @unique  // one row per topic per user
  status          String   @default("not_started")  // 'not_started' | 'in_progress' | 'completed' | 'mastered'
  score           Float    @default(0)  // best quiz score 0..1
  attempts        Int      @default(0)
  timeSpentSec    Int      @default(0)
  lastAttemptAt   DateTime?
  completedAt     DateTime?
  masteryLevel    Float    @default(0)  // 0..1 — rolling avg of last 3 attempts
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
}

// =====================================================================
// Phase 22e — Study Session + Calendar + Timetable
// =====================================================================

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  subjectId       String?
  topicId         String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  durationSec     Int      @default(0)
  status          String   @default("active")  // 'active' | 'completed' | 'abandoned'
  lastScreen      String?  // where the student was when they left
  flashcardsReviewed Int   @default(0)
  quizzesTaken    Int      @default(0)
  topicsStudied   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model CalendarEntry {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime  // the calendar day (stored as date at midnight)
  type        String   // 'study' | 'exam' | 'flashcard' | 'quiz' | 'break'
  title       String
  description String?
  durationMin Int      @default(0)
  score       Float?   // for quizzes/exams
  subjectId   String?
  topicId     String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([type])
}

model Timetable {
  id          String   @id @default(uuid())
  userId      String
  dayOfWeek   Int      // 0=Sunday, 1=Monday, ... 6=Saturday
  startTime   String   // "16:00" (24h format)
  endTime     String   // "17:00"
  subjectId   String?
  subjectName String
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([userId, dayOfWeek, startTime])
  @@index([userId])
}

// =====================================================================
// Phase 23 — Email authentication (password reset + OTP verification)
// =====================================================================

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique  // random secure token for reset link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String           // 6-digit code
  purpose   String           // 'signup' | 'family_child'
  payload   Json?            // optional context (e.g. childName for family_child)
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([otp])
}
