// Prisma schema for StudyBuddy AI on Neon Postgres
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  clerkUserId       String   @unique
  email             String?  @unique
  name              String?
  plan              String   @default("free")
  encryptedApiKey   String?
  grade             String?
  subjects          String[]
  ambitions         String[]
  learningLanguage  String   @default("English")
  // Phase 5 — admin fields
  role              String   @default("user") // 'user' | 'admin'
  banned            Boolean  @default(false)
  lastActive        DateTime?
  // Phase 6 — auth + profile fields
  onboardingCompleted Boolean @default(false)
  avatarUrl         String?
  notificationsEnabled Boolean @default(true)
  darkMode          Boolean  @default(false)
  lastLogin         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studySets       StudySet[]
  attempts        Attempt[]
  cardReviews     CardReview[]
  topicMastery    TopicMastery[]
  learningPaths   LearningPath[]
  booksCreated    Book[]
  topicsCreated   Topic[]
  aiCallLogs      AiCallLog[]
  adminLogs       AdminLog[]
  sessions        UserSession[]
}

// Phase 6 — login/logout audit trail
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  sessionType  String   // 'login' | 'logout'
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model StudySet {
  id          String   @id @default(uuid())
  userId      String
  title       String
  sourceType  String   @default("text") // 'text' | 'pdf' | 'image' | 'graph'
  sourceText  String?
  subject     String?
  topic       String?
  topicId     String?  // Phase 4 — optional link to Topic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]
  topicRef  Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
}

model Card {
  id            String   @id @default(uuid())
  setId         String
  topicId       String?  // Phase 4 — optional direct link to Topic
  cardType      String   // 'flashcard' | 'mcq'
  front         String?
  back          String?
  question      String?
  options       Json?
  correctIndex  Int?
  explanation   String?
  subject       String?
  topic         String?
  createdAt     DateTime @default(now())

  set          StudySet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  topicRef     Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts     Attempt[]
  cardReviews  CardReview[]

  @@index([setId])
  @@index([subject, topic])
  @@index([topicId])
}

model Attempt {
  id              String   @id @default(uuid())
  userId          String
  cardId          String
  selectedIndex   Int?
  isCorrect       Boolean?
  responseTimeMs  Int?
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
  @@index([userId, cardId])
}

model CardReview {
  id              String   @id @default(uuid())
  userId          String
  cardId          String
  easeFactor      Float    @default(2.5)
  intervalDays    Float    @default(0)
  repetitions     Int      @default(0)
  dueDate         DateTime @default(now())
  lapses          Int      @default(0)
  lastReviewDate  DateTime?
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueDate])
}

model TopicMastery {
  id               String   @id @default(uuid())
  userId           String
  subject          String
  topic            String
  masteryLevel     Float    @default(0) // 0..1
  totalAttempts    Int      @default(0)
  correctAttempts  Int      @default(0)
  lastUpdated      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topic])
  @@index([userId])
}

model LearningPath {
  id         String   @id @default(uuid())
  userId     String
  skill      String
  level      String
  goal       String?
  roadmap    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([userId])
}

model Lesson {
  id          String   @id @default(uuid())
  pathId      String
  title       String
  content     String?
  orderIndex  Int      @default(0)
  completed   Boolean  @default(false)

  path  LearningPath  @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId])
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — Study Room / Topic Deep Dive
// ─────────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  subject     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Phase 5 — content management
  chapterId       String?  // link to a Chapter (if part of a Book)
  published       Boolean  @default(false)
  createdById     String?  // admin who created it
  lessonContent   Json?    // cached AI lesson content

  studySets   StudySet[]
  cards       Card[]
  lessons     TopicLesson[]
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([subject, name])
  @@index([subject])
  @@index([chapterId])
  @@index([published])
}

model TopicLesson {
  id         String   @id @default(uuid())
  topicId    String
  level      String   @default("beginner") // beginner | intermediate | advanced
  content    Json     // { introduction, keyConcepts[], examples[], formulas[], summary }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, level])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────
// Phase 5 — Admin Panel & AI Provider Management
// ─────────────────────────────────────────────────────────────

model AiProvider {
  id                  String   @id @default(uuid())
  name                String
  providerType        String   // 'openai' | 'glm' | 'gemini' | 'openrouter' | 'huggingface' | 'pollinations'
  enabled             Boolean  @default(true)
  apiKeyEncrypted     String?
  baseUrl             String?
  model               String?
  maxTokens           Int      @default(2048)
  costPer1kTokens     Float    @default(0)
  isDefault           Boolean  @default(false)
  priority            Int      @default(100) // lower = higher priority
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  aiCallLogs  AiCallLog[]

  @@index([enabled, priority])
}

model Book {
  id            String   @id @default(uuid())
  title         String
  description   String?
  coverImageUrl String?
  createdById   String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chapters   Chapter[]

  @@index([published])
  @@index([createdById])
}

model Chapter {
  id          String   @id @default(uuid())
  bookId      String
  title       String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([bookId])
}

model AiCallLog {
  id                String   @id @default(uuid())
  userId            String?
  providerId        String?
  providerType      String?
  model             String?
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  cost              Float    @default(0)
  status            String   // 'success' | 'error'
  errorMessage      String?
  route             String? // which API route made the call
  createdAt         DateTime @default(now())

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  AiProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
}

model AdminLog {
  id            String   @id @default(uuid())
  adminUserId   String?
  action        String
  details       Json?
  createdAt     DateTime @default(now())

  adminUser  User?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([createdAt])
}
