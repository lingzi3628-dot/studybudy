// Prisma schema for StudyBuddy AI on Neon Postgres
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  clerkUserId       String   @unique
  email             String?  @unique
  name              String?
  plan              String   @default("free")
  encryptedApiKey   String?
  passwordHash      String?
  grade             String?
  subjects          String[]
  ambitions         String[]
  learningLanguage  String   @default("English")
  role              String   @default("user")
  banned            Boolean  @default(false)
  lastActive        DateTime?
  onboardingCompleted Boolean @default(false)
  avatarUrl         String?
  notificationsEnabled Boolean @default(true)
  darkMode          Boolean  @default(false)
  lastLogin         DateTime?
  // Monetization fields
  planId            String?
  tokenBalance      Int      @default(1000)
  currentModel      String   @default("study_buddy_free")
  subscriptionExpiry DateTime?
  activationKey     String?
  tokenResetDate    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userPlan              Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  studySets             StudySet[]
  attempts              Attempt[]
  cardReviews           CardReview[]
  topicMastery          TopicMastery[]
  learningPaths         LearningPath[]
  booksCreated          Book[]
  topicsCreated         Topic[]
  aiCallLogs            AiCallLog[]
  adminLogs             AdminLog[]
  sessions              UserSession[]
  paymentTransactions   PaymentTransaction[]
  activationKeys        ActivationKey[]
  tokenUsageLogs        TokenUsageLog[]
  dailyUsages           DailyUsage[]
  conceptMaps           ConceptMap[]
  // Phase 12 — paths, modules, gamification, study room state
  // (learningPaths is already declared above)
  pathProgress          UserPathProgress[]
  userXp                UserXp?
  badges                UserBadge[]
  leaderboard           Leaderboard?
  studyRoomStates       StudyRoomState[]
  dailyReviews          DailyReview[]

  // Relations for search settings are handled in SearchSettings model
}

// login/logout audit trail
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  sessionType  String   // 'login' | 'logout'
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model StudySet {
  id          String   @id @default(uuid())
  userId      String
  title       String
  sourceType  String   @default("text") // 'text' | 'pdf' | 'image' | 'graph'
  sourceText  String?
  subject     String?
  topic       String?
  topicId     String?  // optional link to Topic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]
  topicRef  Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
}

model Card {
  id            String   @id @default(uuid())
  setId         String
  topicId       String?  // optional direct link to Topic
  cardType      String   // 'flashcard' | 'mcq'
  front         String?
  back          String?
  question      String?
  options       Json?
  correctIndex  Int?
  explanation   String?
  subject       String?
  topic         String?
  createdAt     DateTime @default(now())

  set          StudySet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  topicRef     Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts     Attempt[]
  cardReviews  CardReview[]

  @@index([setId])
  @@index([subject, topic])
  @@index([topicId])
}

model Attempt {
  id              String   @id @default(uuid())
  userId          String
  cardId          String
  selectedIndex   Int?
  isCorrect       Boolean?
  responseTimeMs  Int?
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
  @@index([userId, cardId])
}

model CardReview {
  id              String   @id @default(uuid())
  userId          String
  cardId          String
  easeFactor      Float    @default(2.5)
  intervalDays    Float    @default(0)
  repetitions     Int      @default(0)
  dueDate         DateTime @default(now())
  lapses          Int      @default(0)
  lastReviewDate  DateTime?
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueDate])
}

model TopicMastery {
  id               String   @id @default(uuid())
  userId           String
  subject          String
  topic            String
  masteryLevel     Float    @default(0) // 0..1
  totalAttempts    Int      @default(0)
  correctAttempts  Int      @default(0)
  lastUpdated      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topic])
  @@index([userId])
}

model LearningPath {
  id              String   @id @default(uuid())
  userId          String?  // null for admin templates
  skill           String
  level           String
  goal            String?
  subject         String?
  topicId         String?
  coverImageUrl   String?
  roadmap         Json
  // Phase 12: path lifecycle + template metadata
  status          String   @default("active")  // 'active' | 'completed' | 'archived'
  isTemplate      Boolean  @default(false)
  isPublished     Boolean  @default(false)     // for templates: visible to users
  sourceTemplateId String? // if cloned from a template, store its id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessons         Lesson[]
  modules         PathModule[]
  studyRoomStates StudyRoomState[]
  dailyReviews   DailyReview[]

  @@index([userId])
  @@index([isTemplate])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────
// Phase 12 — Path Modules & Items (the new path timeline)
// ─────────────────────────────────────────────────────────────

model PathModule {
  id          String   @id @default(uuid())
  pathId      String
  title       String
  description String?
  orderIndex  Int      @default(0)
  status      String   @default("locked")  // 'locked' | 'unlocked' | 'completed'
  createdAt   DateTime @default(now())

  path        LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  items       PathItem[]

  @@index([pathId])
}

model PathItem {
  id                 String   @id @default(uuid())
  moduleId           String
  type               String   // 'lesson' | 'flashcards' | 'quiz' | 'concept_map' | 'video' | 'project' | 'study_room_start'
  title              String
  contentId          String?  // id of generated resource (study set / concept map / etc.)
  orderIndex         Int      @default(0)
  difficulty         String   @default("medium")  // 'easy' | 'medium' | 'hard'
  isRequired        Boolean  @default(true)
  completionCriteria Json?    // e.g. {"minAccuracy":0.7,"minTimeSec":60}
  createdAt          DateTime @default(now())

  module             PathModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress       UserPathProgress[]

  @@index([moduleId])
}

model UserPathProgress {
  id            String    @id @default(uuid())
  userId        String
  pathItemId    String
  status        String    @default("not_started")  // 'not_started' | 'in_progress' | 'completed' | 'failed'
  score         Float?
  attempts      Int       @default(0)
  timeSpentSec  Int       @default(0)
  completedAt   DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathItem      PathItem  @relation(fields: [pathItemId], references: [id], onDelete: Cascade)

  @@unique([userId, pathItemId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Phase 12 — Gamification (XP, badges, streaks, leaderboard)
// ─────────────────────────────────────────────────────────────

model UserXp {
  id                String   @id @default(uuid())
  userId            String   @unique
  xpAmount         Int      @default(0)
  level            Int      @default(1)
  streakDays       Int      @default(0)
  lastActivityDate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xpAmount])
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String   @default("🏅")
  criteria    Json?    // e.g. {"xp":100,"streakDays":3,"type":"quiz_master"}
  createdAt   DateTime @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Leaderboard {
  id         String   @id @default(uuid())
  userId     String   @unique
  xpTotal    Int      @default(0)
  weeklyXp   Int      @default(0)
  monthXp    Int      @default(0)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Phase 12 — Study Room Persistent State + Daily Review
// ─────────────────────────────────────────────────────────────

model StudyRoomState {
  id                String   @id @default(uuid())
  userId            String
  topicId           String
  pathId            String?
  currentItem        String?  // path item id
  coverImageUrl     String?
  aiTeacherName     String   @default("Professor Bloom")
  aiTeacherAvatar   String   @default("🧙‍♂️")
  aiTeacherStyle    String   @default("encouraging")  // 'encouraging' | 'strict' | 'fun' | 'academic'
  lastVisited       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic             Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  path              LearningPath?  @relation(fields: [pathId], references: [id], onDelete: SetNull)

  @@unique([userId, topicId])
  @@index([userId])
}

model DailyReview {
  id        String   @id @default(uuid())
  userId    String
  pathId    String?
  date      DateTime
  items     Json     // [{itemId, type, question, options, answer, explanation}]
  status    String   @default("pending")  // 'pending' | 'completed'
  score     Float?
  createdAt DateTime @default(now())
  completedAt DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      LearningPath?  @relation(fields: [pathId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}

model Lesson {
  id          String   @id @default(uuid())
  pathId      String
  title       String
  content     String?
  orderIndex  Int      @default(0)
  completed   Boolean  @default(false)

  path  LearningPath  @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId])
}

// ─────────────────────────────────────────────────────────────
// Study Room / Topic Deep Dive
// ─────────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  subject     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // content management
  chapterId       String?  // link to a Chapter (if part of a Book)
  published       Boolean  @default(false)
  createdById     String?  // admin who created it
  lessonContent   Json?    // cached AI lesson content

  studySets   StudySet[]
  cards       Card[]
  lessons     TopicLesson[]
  conceptMaps ConceptMap[]
  studyRoomStates StudyRoomState[]
  learningPaths   LearningPath[]
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([subject, name])
  @@index([subject])
  @@index([chapterId])
  @@index([published])
}

model TopicLesson {
  id         String   @id @default(uuid())
  topicId    String
  level      String   @default("beginner") // beginner | intermediate | advanced
  content    Json     // { introduction, keyConcepts[], examples[], formulas[], summary }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, level])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────
// Admin Panel & AI Provider Management
// ─────────────────────────────────────────────────────────────

model AiProvider {
  id                  String   @id @default(uuid())
  name                String
  providerType        String   // 'openai' | 'glm' | 'gemini' | 'openrouter' | 'huggingface' | 'pollinations'
  enabled             Boolean  @default(true)
  apiKeyEncrypted     String?
  baseUrl             String?
  model               String?
  maxTokens           Int      @default(2048)
  costPer1kTokens     Float    @default(0)
  isDefault           Boolean  @default(false)
  priority            Int      @default(100) // lower = higher priority
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  aiCallLogs  AiCallLog[]

  @@index([enabled, priority])
}

model Book {
  id            String   @id @default(uuid())
  title         String
  description   String?
  coverImageUrl String?
  createdById   String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chapters   Chapter[]

  @@index([published])
  @@index([createdById])
}

model Chapter {
  id          String   @id @default(uuid())
  bookId      String
  title       String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([bookId])
}

model AiCallLog {
  id                String   @id @default(uuid())
  userId            String?
  providerId        String?
  providerType      String?
  model             String?
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  cost              Float    @default(0)
  status            String   // 'success' | 'error'
  errorMessage      String?
  route             String? // which API route made the call
  createdAt         DateTime @default(now())

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  AiProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
}

model AdminLog {
  id            String   @id @default(uuid())
  adminUserId   String?
  action        String
  details       Json?
  createdAt     DateTime @default(now())

  adminUser  User?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Custom admin auth (separate from Clerk)
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   // bcrypt hash
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Monetization — Plans, Tokens, Payments, Activation Keys
// ─────────────────────────────────────────────────────────────

model Plan {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  price                     Float
  currency                  String   @default("USD")
  tokenLimit                Int
  dailyQuizLimit            Int      @default(5)
  dailyFlashcardGenLimit    Int      @default(3)
  // Phase 11: Concept Map features
  dailyConceptMapLimit      Int      @default(1)
  conceptMapEditing         Boolean  @default(false)
  conceptMapExport         Boolean  @default(false)
  features                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users                  User[]
  paymentTransactions    PaymentTransaction[]
  activationKeys         ActivationKey[]
  modelMappings          ModelMapping[]

  @@index([slug])
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String
  planId          String?
  amount          Float?
  currency        String?
  paymentMethod   String   // 'mpesa','binance','minipay','paypal','bank'
  transactionRef  String?
  status          String   @default("pending") // 'pending','confirmed','rejected'
  activationKeyId String?  @unique
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  activationKey   ActivationKey? @relation(fields: [activationKeyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ActivationKey {
  id          String    @id @default(uuid())
  key         String    @unique
  planId      String
  userId      String?
  createdBy   String?   // admin user id
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?
  status      String    @default("active") // 'active','used','revoked'

  plan                  Plan    @relation(fields: [planId], references: [id])
  user                 User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction?

  @@index([planId])
  @@index([status])
  @@index([userId])
}

model TokenUsageLog {
  id          String   @id @default(uuid())
  userId      String
  model       String
  tokensUsed  Int
  costTokens  Int
  feature     String   // 'flashcards','quiz','search','tutor','graph','translate'
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ModelMapping {
  id                  String   @id @default(uuid())
  modelName           String   @unique // 'study_buddy_free', 'study_buddy_king', etc.
  providerId          String?
  modelIdentifier     String?  // 'gpt-4','gemini-pro','glm-4', etc.
  tokenCostMultiplier Float    @default(1.0)
  requiresPremium     Boolean  @default(false)
  planSlug            String?  // required plan slug
  emoji               String   @default("🤖")
  displayName         String   @default("Study Buddy")

  plan                Plan?    @relation(fields: [planSlug], references: [slug], onDelete: SetNull)

  @@index([modelName])
}

model PaymentSetting {
  id              String   @id @default(uuid())
  method          String   @unique // 'mpesa','binance','minipay','paypal','bank'
  label           String
  instructions    String
  details         Json?    // { paybill, account, address, email, etc. }
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DailyUsage {
  id          String   @id @default(uuid())
  userId      String
  feature     String   // 'search','cards','quiz','tutor','graph','translate','learning_path'
  usageDate   DateTime @default(now())
  count       Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, usageDate])
  @@index([userId, usageDate])
}

model SearchSettings {
  id                        Int      @id @default(1)
  youtubeApiKeyEncrypted    String?
  pollinationsBaseUrl       String   @default("https://image.pollinations.ai/prompt/")
  imageSearchEnabled        Boolean  @default(true)
  videoSearchEnabled        Boolean  @default(true)
  imageTokenCost            Int      @default(10)
  videoTokenCost            Int      @default(50)
  freeDailyImageLimit       Int      @default(5)
  freeDailyVideoLimit       Int      @default(3)
  updatedAt                 DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Phase 11 — Concept Maps
// ─────────────────────────────────────────────────────────────

model ConceptMap {
  id          String   @id @default(uuid())
  userId      String?                          // null = admin-generated global map
  topicId     String?
  title       String
  nodes       Json                              // [{ id, label, description, type? }]
  edges       Json                              // [{ source, target, label }]
  isPublic    Boolean  @default(false)
  sourceType  String   @default("topic")       // 'topic' | 'text' | 'study_set'
  sourceText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
  @@index([isPublic])
}

model ConceptMapSettings {
  id                        Int      @id @default(1)
  enabled                   Boolean  @default(true)
  tokenCost                 Int      @default(300)
  freeDailyLimit            Int      @default(1)
  updatedAt                 DateTime @updatedAt
}
