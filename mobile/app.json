{
  "expo": {
    "name": "StudyBuddy",
    "slug": "studybuddy-mobile",
    "scheme": "studybuddy",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/d4d97d0e-6f9a-49aa-8579-a869ca8dacbc",
      "checkAutomatically": "NEVER"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.studybuddy.mobile"
    },
    "android": {
      "package": "app.studybuddy.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6657E8"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6657E8",
          "defaultChannel": "study-reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d4d97d0e-6f9a-49aa-8579-a869ca8dacbc"
      }
    }
  }
}
